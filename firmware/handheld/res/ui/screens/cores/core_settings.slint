import { Theme } from "../../theme.slint";
import { Backend } from "../../common.slint";
import { ListViewBase } from "../../components/list_view.slint";
import { CoreSetting, CoreSettingType } from "types.slint";
import { Icons } from "../../icons.slint";
import { ListView } from "std-widgets.slint";
import { ScrollingText } from "../../components/scrolling_text.slint";
import { OutlinedText, OutlinedImage, OutlinedFrame } from "../../components/outline.slint";

// Drawn over the darkened game, like the Cheats page (see OverlayColors in game.slint).
global SettingsColors {
    out property <color> text: white;
}

// GB-173: the box is as wide as the current choice (not the widest one), and the arrows take
// space only while the row is selected, so the setting's label keeps as much room as possible.
component ListBox {
    in-out property <int> index;
    in property <[string]> choices;
    in property <bool> focused;

    callback on-changed();

    HorizontalLayout {
        spacing: 2px;

        if root.focused: OutlinedImage {
            source: Icons.left-caret;
            tint: SettingsColors.text;
        }

        OutlinedText {
            text-color: SettingsColors.text;
            text: root.index >= 0 && root.index < root.choices.length ? root.choices[root.index] : "";
        }

        if root.focused: OutlinedImage {
            source: Icons.right-caret;
            tint: SettingsColors.text;
        }
    }

    if focused: FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if !focused {
                return reject;
            }
            if event.text == Key.LeftArrow {
                root.index = max(root.index - 1, 0);
                on-changed();
                return accept;
            }
            if event.text == Key.RightArrow {
                root.index = min(root.index + 1, root.choices.length - 1);
                on-changed();
                return accept;
            }
            reject
        }
    }
}

export component CoreSettingListItem {
    in-out property <CoreSetting> item;
    in property <bool> selected;

    if selected: OutlinedFrame {
        x: 1px;
        y: 1px;
        width: root.width - 2px;
        height: root.height - 2px;
        line-color: SettingsColors.text;
    }

    // i-popup := PopupWindow {
    //     Rectangle {
    //         height: 100%;
    //         width: 100%;
    //         border-width: 1px;
    //         border-color: black;
    //         background: white;
    //     }

    //     x: 0;
    //     y: -root.absolute-position.y + 8px;
    //     height: i-layout.min-height;
    //     width: i-layout.min-width;

    //     i-layout := VerticalLayout {
    //         padding: 4px;
    //         for choice in root.item.choices: Text {
    //             text: choice;
    //         }
    //     }

    //     forward-focus: i-focus-scope;
    //     i-focus-scope := FocusScope {
    //         key-released(event) => {
    //             if (event.text == "x") {
    //                 parent.close();
    //                 return accept;
    //             }
    //             reject
    //         }
    //     }
    // }

    if selected: FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if event.text == "a" {
                handle-selected();
            }
            reject
        }
    }

    public function handle-selected() {
        if item.type == CoreSettingType.action {
            Backend.game-settings-set(item.id, item.value);
        } else if item.type == CoreSettingType.checkbox {
            item.value = (item.value == 0) ? 1 : 0;
            Backend.game-settings-set(item.id, item.value);
        }
    }

    // GB-173: the label gets the width left of the value, elided, and scrolls while its row is
    // selected. Only the height comes from the text: the list gives the row its width, and nothing
    // read by the layout may depend on that width (see ScrollingText).
    private property <length> value-left: item.type == CoreSettingType.list
        ? i-list.x
        : item.type == CoreSettingType.checkbox ? root.width - (root.height - 4px) - 4px : root.width - 4px;

    // The rows are 20 px high (CoreSettingListBase).
    min-height: 20px;

    // GB-174: an outlined elided label on the rows, the scrolling one only on the selected row.
    if !root.selected: OutlinedText {
        x: 4px;
        width: max(0px, root.value-left - self.x - 6px);
        height: root.height;
        text: item.label;
        text-color: SettingsColors.text;
        elide: true;
    }
    if root.selected: ScrollingText {
        x: 4px;
        width: max(0px, root.value-left - self.x - 6px);
        text: item.label;
        active: true;
        text-color: SettingsColors.text;
        outline: true;
    }

    if item.type == CoreSettingType.checkbox: Rectangle {
        x: parent.width - self.width - 4px;
        width: self.height;
        height: parent.height - 4px;

        OutlinedFrame {
            line-color: SettingsColors.text;
        }

        if (item.value != 0): Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            background: SettingsColors.text;
        }
    }

    // Always present (empty and hidden for other types), so the label can read its position.
    i-list := ListBox {
        visible: item.type == CoreSettingType.list;
        x: parent.width - self.width - 4px;
        index: item.value;
        choices: item.type == CoreSettingType.list ? item.choices : [];
        focused: root.selected && item.type == CoreSettingType.list;
        on-changed => {
            item.value = self.index;
            Backend.game-settings-set(item.id, item.value);
        }
    }

    @children
}

export component CoreSettingListBase inherits ListView {
    in property <[CoreSetting]> model: Backend.core-settings;
    in-out property <int> current-item: 0;

    callback current-item-changed(current-item: int);

    public function set-current-item(index: int) {
        if index < 0 || index >= model.length || index == root.current-item {
            return;
        }
        bring-into-view(index);

        current-item = index;
        focus-item = index;
        current-item-changed(current-item);
    }

    private property <length> item-height: self.viewport-height / self.model.length;
    private property <int> into-view-item: 0;
    private property <length> into-view-item-y: root.item-y(root.into-view-item);
    private property <length> current-item-y: root.item-y(root.focus-item);
    private property <int> focus-item: 0;
    private property <bool> has-item-been-selected: false;

    vertical-scrollbar-policy: always-off;
    horizontal-scrollbar-policy: always-off;

    pure function item-y(index: int) -> length {
        return root.viewport-y + index * root.item-height;
    }

    pure function item-at-y(y: length) -> int {
        return min(root.model.length - 1, max(0, round(y / root.item-height)));
    }

    function bring-into-view(index: int) {
        if (index < 0 || index >= model.length) {
            return;
        }
        into-view-item = index;

        if (into-view-item-y < 0) {
            self.viewport-y += 0 - into-view-item-y;
        }
        if (into-view-item-y + item-height > self.visible-height) {
            self.viewport-y -= into-view-item-y + item-height - self.visible-height;
        }
    }

    public function focus-up() {
        root.set-focus-item(root.focus-item - 1);
    }

    public function focus-down() {
        root.set-focus-item(root.focus-item + 1);
    }

    protected function select-focus-item() {
        root.set-current-item(root.focus-item);
    }

    protected function set-focus-item(index: int) {
        root.focus-item = min(root.model.length - 1, max(0, index));
        root.bring-into-view(root.focus-item);
        root.select-focus-item();
    }

    for item[index] in root.model: CoreSettingListItem {
        height: 20px;
        item: item;
        selected: index == root.current-item;
    }
}

export component CoreSettingList {
    forward-focus: i-focus-scope;

    i-focus-scope := FocusScope {
        i-list := CoreSettingListBase {
            width: 100%;
            height: 100%;
        }

        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                i-list.focus-up();
                return accept;
            } else if (event.text == Key.DownArrow) {
                i-list.focus-down();
                return accept;
            }
            reject
        }
    }
}
